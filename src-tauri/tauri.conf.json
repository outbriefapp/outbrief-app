{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OutBrief",
  "version": "0.0.1",
  "identifier": "ai.outbrief.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OutBrief",
        "hiddenTitle": true,
        "width": 420,
        "height": 760,
        "minWidth": 360,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "files": {
        "Resources/zh-Hans.lproj/InfoPlist.strings": "./macos/zh-Hans.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings"
      }
    }
  }
}
